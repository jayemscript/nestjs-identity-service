# Local development example. Never put real passwords in this tracked file.

NODE_ENV=development
PORT=7000
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:3000
# Shared PostgreSQL endpoint. Set DB_SSL=true and supply a verified CA in production.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_db
DB_SSL=false
DB_CA_CERT=

# Runtime credentials. Each login has privileges only in its own schema.
AUTH_DB_USER=identity_auth_local
AUTH_DB_PASS=REPLACE_WITH_LOCAL_PASSWORD
IDENTITY_DB_USER=identity_policy_local
IDENTITY_DB_PASS=REPLACE_WITH_LOCAL_PASSWORD
AUDIT_DB_USER=identity_audit_local
AUDIT_DB_PASS=REPLACE_WITH_LOCAL_PASSWORD

# Supply these only to the separate deployment/maintenance jobs in production.
MIGRATION_DB_USER=identity_migrator_local
MIGRATION_DB_PASS=REPLACE_WITH_LOCAL_PASSWORD
RETENTION_DB_USER=identity_retention_local
RETENTION_DB_PASS=REPLACE_WITH_LOCAL_PASSWORD
